# Copy this file to .env and fill in values from Supabase:
# Project dashboard -> Connect -> ORMs -> Prisma
# Never commit .env.

# Pooled connection used by the running app (Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection used by Prisma CLI for migrations (Session pooler, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings -> API Keys). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
